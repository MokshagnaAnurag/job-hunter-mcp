# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ─── OpenAI / LLM (for resume tailoring, JD analysis) ─────
OPENAI_API_KEY=sk-...

# ─── Overleaf Git Integration (Premium feature) ───────────
OVERLEAF_GIT_URL=https://git.overleaf.com/your-project-id
OVERLEAF_GIT_TOKEN=your-git-token
# NOTE: Overleaf Git integration requires a premium account.
# The token is used for authenticated Git operations only.

# ─── LaTeX Compilation ─────────────────────────────────────
# Path to local TeX Live / MiKTeX installation
# Leave empty to skip local compilation
LATEX_BIN_PATH=

# ─── Job Search API Keys (optional, per-source) ───────────
# Official API keys for job platforms that support them
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
THE_MUSE_API_KEY=
ARBEITNOW_API_KEY=

# ─── Email Monitoring (optional) ──────────────────────────
# Gmail OAuth credentials (for application status monitoring)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ─── Calendar Integration (optional) ──────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ─── Server Configuration ─────────────────────────────────
MCP_TRANSPORT=stdio
# Options: stdio, http
HTTP_PORT=3847
NODE_ENV=development
